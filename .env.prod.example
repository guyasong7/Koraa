# Koraa — production variables read by docker-compose.prod.yml ITSELF.
#
#   cp .env.prod.example .env.prod    # then fill in every value
#
# This file is only for values compose interpolates: Postgres credentials and
# the web image's build args. Django's own configuration lives in
# backend/.env.prod — see backend/.env.prod.example.
#
# Pass it explicitly on every command, or compose will not read it:
#   docker compose -f infrastructure/docker/docker-compose.prod.yml \
#     --env-file .env.prod up -d --build
#
# .env.prod is gitignored. Never commit the filled-in copy.

# ─── Postgres ─────────────────────────────────────────────────────────────────
# These create the database on first boot and are interpolated into the
# DATABASE_URL that compose hands the backend. Changing POSTGRES_PASSWORD after
# the first boot does NOT change the password inside the existing volume — you
# would have to ALTER USER by hand, so pick a real one now.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_USER=koraa
POSTGRES_PASSWORD=
POSTGRES_DB=koraa_db

# ─── Next.js build args ───────────────────────────────────────────────────────
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, not read at
# runtime. Changing any value below requires `up -d --build` to take effect;
# a plain restart keeps serving the old values.
#
# Everything here ships to the browser. Do not put a secret in this section.

# The apex domain. Storefronts are served from <slug>.<root domain>, so the
# proxy uses this to tell a storefront subdomain from the marketing site. Must
# match KORAA_ROOT_DOMAIN in backend/.env.prod and the server_name entries in
# infrastructure/nginx/koraa.conf.
NEXT_PUBLIC_ROOT_DOMAIN=koraa.cm

# Where the browser reaches the API. Two supported shapes:
#   https://api.koraa.cm/api/v1 — dedicated API host, needs CORS
#   /api/v1                     — same-origin via nginx, needs no CORS and
#                                 works for custom merchant domains
# The same-origin path is the simpler choice unless something outside this
# stack has to call the API cross-origin.
NEXT_PUBLIC_API_URL=/api/v1

# Origin allowed to drive the storefront preview iframe via postMessage. The
# preview validates event.origin against it, so a wrong value silently breaks
# live preview. Same origin as the dashboard, i.e. the apex.
NEXT_PUBLIC_DASHBOARD_ORIGIN=https://koraa.cm

# ─── Firebase (client SDK, social login) ──────────────────────────────────────
# From the Firebase console → Project settings → Your apps → SDK setup. These
# are public by design; access is controlled by Firebase security rules, not by
# hiding the key. FIREBASE_PROJECT_ID in backend/.env.prod must name this same
# project or every social login is rejected when the backend verifies the token.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Analytics only. Nothing in the app reads it yet; safe to leave empty.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── TLS / Let's Encrypt ──────────────────────────────────────────────────────
# Used by infrastructure/docker/init-letsencrypt.sh and the certbot service.

# Expiry and problem notices go here. Let's Encrypt requires a real address.
CERTBOT_EMAIL=

# Storefronts need a wildcard certificate (*.koraa.cm), and Let's Encrypt
# only issues wildcards over the DNS-01 challenge — HTTP-01 cannot do it. So a
# DNS API token is required, not optional.
#
# Cloudflare → My Profile → API Tokens → Create Token, using the "Edit zone
# DNS" template scoped to this zone only. Needs Zone:DNS:Edit and Zone:Zone:Read.
#
# If DNS is not on Cloudflare, leave this empty and run the bootstrap script
# with --manual; renewals then have to be run by hand every 60 days. See
# docs/DEPLOYMENT.md.
CLOUDFLARE_DNS_API_TOKEN=
