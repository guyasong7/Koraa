# Koraa — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Core Django ──────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://koraa:koraa_dev_secret@localhost:5432/koraa_db
POSTGRES_USER=koraa
POSTGRES_PASSWORD=koraa_dev_secret
POSTGRES_DB=koraa_db

# ─── Cache / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your-resend-api-key
DEFAULT_FROM_EMAIL=Koraa <noreply@koraa.cm>

# ─── Koraa Platform ───────────────────────────────────────────────────────────
KORAA_STOREFRONT_DOMAIN=koraa.cm
KORAA_DASHBOARD_URL=http://localhost:3000

# ─── Storage (Cloudflare R2 — production only) ────────────────────────────────
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_CUSTOM_DOMAIN=

# ─── Firebase Admin SDK ──────────────────────────────────────────────
# Used to generate email action links (verification, password reset) server-side
# so they point to koraa.cm/_/auth/action and arrive in our own branded emails.
#
# FIREBASE_PROJECT_ID: matches KORAA_PUBLIC_FIREBASE_PROJECT_ID on the frontend.
FIREBASE_PROJECT_ID=koraa-a3ecd
#
# FIREBASE_SERVICE_ACCOUNT_JSON: paste the full JSON from Firebase Console →
#   Project Settings → Service Accounts → Generate new private key.
# Paste it as a single line. If absent, the SDK falls back to Application
# Default Credentials (works on GCP-hosted environments with an attached SA).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"koraa-a3ecd",...}

# ─── Fapshi Payments ──────────────────────────────────────────────
FAPSHI_API_USER=your-fapshi-api-user
FAPSHI_API_KEY=your-fapshi-api-key
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_WEBHOOK_SECRET=your-webhook-secret
