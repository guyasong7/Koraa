# Koraa — Django production environment.
#
#   cp backend/.env.prod.example backend/.env.prod   # then fill in every value
#
# Loaded into the backend, migrate, celery_worker and celery_beat containers by
# docker-compose.prod.yml (env_file). Unlike .env.prod at the repo root, compose
# does not interpolate this file — it passes the lines through verbatim, so
# ${...} references do NOT work here.
#
# backend/.env.prod is gitignored, and backend/.dockerignore keeps every .env
# out of the image. Never commit the filled-in copy.

# ─── Core Django ──────────────────────────────────────────────────────────────
# Required. SimpleJWT signs access tokens with this, so a leaked or guessable
# key lets anyone mint a token for any merchant. production.py refuses to boot
# if it is shorter than 50 characters or still has the django-insecure- prefix.
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=

DEBUG=False

# Required. Every hostname the backend answers on. production.py refuses to boot
# while this is still the development default. Include the internal name
# `backend` so the Next.js server components and the container healthcheck can
# reach it over the compose network.
ALLOWED_HOSTS=koraa.africa,www.koraa.africa,api.koraa.africa,.koraa.africa,backend

# ─── Database & Redis ─────────────────────────────────────────────────────────
# Deliberately absent: docker-compose.prod.yml sets DATABASE_URL and REDIS_URL
# as container environment, which wins over anything written here. Set them only
# when pointing at a managed database outside this stack — and remember that a
# value here is then shadowed by compose unless you also edit the compose file.

# ─── Domains ──────────────────────────────────────────────────────────────────
# The apex domain. Drives the CORS wildcard regex that lets every
# <slug>.koraa.africa storefront call the API. Must match
# NEXT_PUBLIC_ROOT_DOMAIN in .env.prod.
KORAA_ROOT_DOMAIN=koraa.africa

# Suffix used when building a new store's default storefront URL.
KORAA_STOREFRONT_DOMAIN=koraa.africa

# Absolute base URL used in outbound email links (verification, password reset,
# staff invitations). A wrong value sends users to a dead link, so it needs the
# scheme and no trailing slash.
KORAA_DASHBOARD_URL=https://koraa.africa

# ─── CORS & CSRF ──────────────────────────────────────────────────────────────
# Both are derived automatically: CORS from KORAA_ROOT_DOMAIN (apex, www, and a
# regex covering every subdomain), CSRF_TRUSTED_ORIGINS from ALLOWED_HOSTS.
# Setting either REPLACES the derived list rather than adding to it.
#
# Custom merchant domains (StoreDomain records) are not covered by the subdomain
# regex. Either list them here, or set NEXT_PUBLIC_API_URL=/api/v1 so storefront
# requests are same-origin and CORS never applies.
# CORS_ALLOWED_ORIGINS=https://koraa.africa,https://shop.example.com
# CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9\-]+\.koraa\.africa$
# CSRF_TRUSTED_ORIGINS=https://koraa.africa,https://api.koraa.africa

# ─── HTTPS ────────────────────────────────────────────────────────────────────
# nginx already redirects HTTP to HTTPS, and Django trusts X-Forwarded-Proto, so
# leaving this True is correct and costs nothing. Set it False only when
# something in front terminates TLS and cannot forward that header — otherwise
# Django sees plain HTTP and redirect-loops the client.
SECURE_SSL_REDIRECT=True

# ─── Email ────────────────────────────────────────────────────────────────────
# The default backend prints to the console, which in production means
# verification and password-reset mail is never delivered. Configure real SMTP.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Koraa <noreply@koraa.africa>

# ─── Firebase (server-side token verification) ────────────────────────────────
# The backend verifies Firebase ID tokens against this project id. It MUST name
# the same project as NEXT_PUBLIC_FIREBASE_PROJECT_ID in .env.prod, or the
# audience check fails and every social login is rejected. Note that base.py has
# a hardcoded default here — set it explicitly so a project rename cannot leave
# the stale default in place silently.
FIREBASE_PROJECT_ID=

# ─── Fapshi (payments & payouts) ──────────────────────────────────────────────
# From the Fapshi dashboard. Empty credentials do not fail at boot — checkout
# fails later at the first API call instead, so verify these before launch.
#
# BASE_URL selects the environment: https://live.fapshi.com charges real money,
# https://sandbox.fapshi.com does not. Sandbox and live keys are not
# interchangeable.
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_BASE_URL=https://live.fapshi.com

# ─── Didit (merchant identity verification) ───────────────────────────────────
# x-api-key for verification.didit.me. Merchant onboarding raises
# "DIDIT_API_KEY is not configured" without it.
DIDIT_API_KEY=

# ─── OpenRouter (AI product & store copy generation) ──────────────────────────
# Read through python-decouple, not django-environ. The AI description endpoints
# return a 4xx explaining the key is missing rather than breaking anything else,
# so this is safe to leave empty if the feature is not being shipped.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Media storage ────────────────────────────────────────────────────────────
# Uploads default to the media_files docker volume, which nginx serves at
# /media/. That works, but it lives on one host: the volume is what has to be
# backed up, and it does not survive moving to a second web node.
#
# Setting all four R2 values switches media to Cloudflare R2. Partial
# configuration is ignored and falls back to local disk rather than refusing to
# boot, so a typo here shows up as uploads quietly landing on the wrong side.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Public hostname bound to the bucket. Without it, URLs use the R2 endpoint,
# which is not a good public URL.
# R2_CUSTOM_DOMAIN=media.koraa.africa

# Legacy AWS S3 path in base.py, superseded by the R2 block above. Leave False:
# it sets MEDIA_URL without MEDIA_ROOT, and it does not compose with R2.
USE_S3=False

# Static files are collected at image build time and served by WhiteNoise from
# inside gunicorn. Nothing to configure, and no collectstatic step on deploy.

# ─── Gunicorn ─────────────────────────────────────────────────────────────────
# Starting point is (2 x cores) + 1. Each worker is a separate process holding
# its own DB connections, so raising this raises Postgres connection use too.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
# Must stay above the 15s timeout the Fapshi calls use, or a slow payment
# confirmation is killed mid-flight.
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# ─── Logging ──────────────────────────────────────────────────────────────────
# Goes to stdout for the container runtime to collect: docker compose logs.
DJANGO_LOG_LEVEL=INFO

# Reuse each Postgres connection for this many seconds instead of opening one
# per request.
CONN_MAX_AGE=60
