{
  "name": "koraa-web",
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  // The Pages build output directory produced by @cloudflare/next-on-pages.
  "pages_build_output_dir": ".vercel/output/static",
  "compatibility_date": "2025-01-01",
  // nodejs_compat gives the edge runtime access to the Node.js APIs that
  // Next.js server components and route handlers use internally.
  "compatibility_flags": ["nodejs_compat"]
}
