# Production defaults for the browser bundle — committed on purpose.
#
# ONLY PUBLIC VALUES BELONG IN THIS FILE. Everything here is inlined into the
# client bundle by next.config.ts and served to every visitor, so committing it
# reveals nothing that opening devtools would not. Server-side secrets — the
# Firebase *admin* credentials, database URLs, API keys that authorise rather
# than identify — must never be added here. Those belong in the host's own
# secret store and nowhere in git.
#
# In particular KORAA_PUBLIC_FIREBASE_API_KEY is not a secret. It identifies the
# Firebase project; it does not grant access to it. Access is controlled by
# Firebase Security Rules and the Authorized-domains list, which is why Google
# publishes this value in its own SDK-setup snippets.
#
# WHY THIS FILE EXISTS
#
# These values are required at *build* time, because they are inlined rather
# than read at runtime. A build without them succeeds and silently ships
# `apiKey: ""` plus a localhost API base — which reaches users as a sign-in
# button that cannot work. Keeping them only in a host's dashboard made every
# new deployment target a fresh chance to ship that bundle, and it did ship:
# koraa-web-eta.vercel.app served apiKey:"" for several deploys running.
#
# Committing the public half removes that failure mode. A clone builds a working
# production bundle with no dashboard configured at all.
#
# PRECEDENCE — how to override this
#
# Next loads, highest priority first:
#   1. the real environment   <- Vercel/Docker vars land here and WIN over this file
#   2. .env.production.local
#   3. .env.local             <- gitignored; local dev keeps its localhost values
#   4. .env.production        <- this file
#   5. .env
#
# So this file is a floor, not a ceiling. To point a deployment somewhere else,
# set the variable in the host and it takes precedence; nothing here needs
# editing. And because .env.local outranks it, `npm run dev` and a local
# `next build` still use your localhost values.

# ── API ──────────────────────────────────────────────────────────────────────
# https, not http: the pages are served over https and browsers block mixed
# content, so an http base fails every request before it is sent. This host is
# an sslip.io name precisely so the EC2 backend can hold a publicly trusted
# certificate without a purchased domain — see infrastructure/aws/setup-letsencrypt.sh.
KORAA_PUBLIC_API_URL=https://44-215-174-165.sslip.io/api/v1

# ── Origins ──────────────────────────────────────────────────────────────────
# The Vercel deployment is the platform host until a custom domain is bought.
# middleware.ts treats *.vercel.app as a platform host rather than a store slug,
# so /auth/* and /dashboard/* serve normally here instead of being rewritten
# onto a storefront.
KORAA_PUBLIC_ROOT_DOMAIN=koraa-web-eta.vercel.app
KORAA_PUBLIC_DASHBOARD_ORIGIN=https://koraa-web-eta.vercel.app
KORAA_PUBLIC_SITE_URL=https://koraa-web-eta.vercel.app

# ── Firebase (client SDK — public, see the note at the top) ───────────────────
KORAA_PUBLIC_FIREBASE_API_KEY=AIzaSyBrjZwFNPedEVYTTVcHaIYpkIPRSxYjDpQ
KORAA_PUBLIC_FIREBASE_AUTH_DOMAIN=koraa-a3ecd.firebaseapp.com
KORAA_PUBLIC_FIREBASE_PROJECT_ID=koraa-a3ecd
KORAA_PUBLIC_FIREBASE_STORAGE_BUCKET=koraa-a3ecd.firebasestorage.app
KORAA_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=848709518405
KORAA_PUBLIC_FIREBASE_APP_ID=1:848709518405:web:77ba687604d94133834f2c
