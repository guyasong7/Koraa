{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteMediaObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::koraa-africa-media/media/*"
    },
    {
      "Sid": "ListOwnBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::koraa-africa-media"
    }
  ]
}
